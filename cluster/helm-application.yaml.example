# Rename this file to a .yaml file and customize it for a cluster Helm chart.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: cluster-component
  namespace: argocd
spec:
  project: default
  source:
    repoURL: https://example.github.io/helm-charts
    chart: chart-name
    targetRevision: 1.2.3
    helm:
      releaseName: cluster-component
      valuesObject: {}
  destination:
    server: https://kubernetes.default.svc
    namespace: cluster-component
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
      - ServerSideApply=true
